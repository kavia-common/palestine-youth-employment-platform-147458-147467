# Frontend environment variables
# Copy this file to .env and fill in the values.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL - Base URL for the backend FastAPI service
# Typical local dev: http://localhost:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# PUBLIC_INTERFACE
# Supabase project URL and anon (public) key for Realtime and client-side operations
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
