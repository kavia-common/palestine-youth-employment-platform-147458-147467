# Frontend environment variables
# IMPORTANT: Do not commit your real secrets. Copy this file to `.env` and fill in values.

# Backend FastAPI base URL (preview runs on port 3001)
# For local/preview: http://localhost:3001 or the provided preview URL.
REACT_APP_API_BASE_URL=http://localhost:3001

# Supabase project URL (e.g., https://YOUR-PROJECT-REF.supabase.co)
REACT_APP_SUPABASE_URL=

# Supabase anon public key
REACT_APP_SUPABASE_ANON_KEY=
